            <Geometry x:Key="AddGeometry">M938.666667 426.666667h-341.333334V85.333333c0-46.933333-38.4-85.333333-85.333333-85.333333s-85.333333 38.4-85.333333 85.333333v341.333334H85.333333c-46.933333 0-85.333333 38.4-85.333333 85.333333s38.4 85.333333 85.333333 85.333333h341.333334v341.333334c0 46.933333 38.4 85.333333 85.333333 85.333333s85.333333-38.4 85.333333-85.333333v-341.333334h341.333334c46.933333 0 85.333333-38.4 85.333333-85.333333s-38.4-85.333333-85.333333-85.333333z</Geometry>
            <DataTemplate x:Key="DetailsViewTemplate">
				<Border Margin="8,6,8,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
					<Border.Effect>
						<DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="1" Color="#000000" />
					</Border.Effect>
					<Grid>
						<Grid.ColumnDefinitions>
							<!-- Col 0: Photo & Identity Badge -->
							<ColumnDefinition Width="Auto" />
							<!-- Col 1: Personal & Contact Information -->
							<ColumnDefinition Width="*" />
							<!-- Col 2: Financial Ledger Status Card -->
							<ColumnDefinition Width="Auto" />
							<!-- Col 3: QR Code Verification Card -->
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<!-- COL 0: Photo & Identity -->
						<StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Width="104">
							<Border Width="92" Height="92" CornerRadius="10" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" ClipToBounds="True" HorizontalAlignment="Center">
								<Grid>
									<!-- Fallback avatar icon -->
									<Path Data="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
										  Stroke="#94A3B8" StrokeThickness="1.5" Width="36" Height="36" Stretch="Uniform"
										  HorizontalAlignment="Center" VerticalAlignment="Center"/>
									<!-- Profile Image -->
									<Image Source="{Binding Path=Data.ImagePath, Converter={StaticResource StringToImageConverter}}" 
										   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
										   hc:ImageAttach.SourceFailed="Resources/no_image.jpg"/>
								</Grid>
							</Border>
							<Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Center">
								<TextBlock Text="{Binding Data.Type, TargetNullValue='Contact'}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
							</Border>
							<TextBlock Text="{Binding Data.PersonID, StringFormat='PID: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
						</StackPanel>

						<!-- COL 1: Personal & Contact Info -->
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
							<!-- Name & Reg Date -->
							<TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" Foreground="#0F172A">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0} {1}">
										<Binding Path="Data.FirstName" />
										<Binding Path="Data.LastName" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>

							<StackPanel Orientation="Horizontal" Margin="0,2,0,10">
								<Path Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
									  Stroke="#94A3B8" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding Data.RegDate, StringFormat='Member since {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
							</StackPanel>

							<!-- Contact Details Grid (Mobile, Email, Address) -->
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="1.2*"/>
								</Grid.ColumnDefinitions>

								<!-- Mobile -->
								<Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,6,6">
									<StackPanel Orientation="Horizontal">
										<Path Data="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
											  Stroke="#2563EB" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
										<StackPanel>
											<TextBlock Text="Mobile" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Data.Mobile}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
										</StackPanel>
									</StackPanel>
								</Border>

								<!-- Email -->
								<Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
									<StackPanel Orientation="Horizontal">
										<Path Data="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
											  Stroke="#2563EB" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
										<StackPanel>
											<TextBlock Text="Email Address" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Data.Email}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
										</StackPanel>
									</StackPanel>
								</Border>

								<!-- Address (if present) -->
								<Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5">
									<StackPanel Orientation="Horizontal">
										<Path Data="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
											  Stroke="#2563EB" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
										<StackPanel>
											<TextBlock Text="Address / Location" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Data.Address, FallbackValue='Not specified', TargetNullValue='Not specified'}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</Grid>
						</StackPanel>

						<!-- COL 2: Ledger Balance Card -->
						<Border Grid.Column="2" Width="180" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,14,0" VerticalAlignment="Center">
							<StackPanel VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Margin="0,0,0,4">
									<Border Background="#FEF3C7" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
										<TextBlock Text="LEDGER" FontSize="9" FontWeight="Bold" Foreground="#B45309"/>
									</Border>
									<TextBlock Text="Current Balance" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
								</StackPanel>
								<TextBlock Text="{Binding Data.Balance, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,6"/>
								<Border Background="{Binding Data.Balance, Converter={StaticResource ColorConvertor}}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
									<TextBlock Text="Ledger Status" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
								</Border>
							</StackPanel>
						</Border>

						<!-- COL 3: QR Verification Card -->
						<Border Grid.Column="3" Width="130" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" VerticalAlignment="Center">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<barcode:SfBarcode x:Name="barcode" Symbology="QRBarcode" Height="86" Width="86" DisplayText="False" HorizontalAlignment="Center">
									<barcode:SfBarcode.Text>
										<MultiBinding StringFormat="{}Name: {0}{2}Mobile: {1}{2}Email: {3}{2}Registration Date: {4}{2}Balance: {5:C}">
											<Binding Path="Text" ElementName="NameText" />
											<Binding Path="Data.Mobile" />
											<Binding Source="{x:Static system:Environment.NewLine}"/>
											<Binding Path="Data.Email" />
											<Binding Path="Data.RegDate" />
											<Binding Path="Data.Balance" />
										</MultiBinding>
									</barcode:SfBarcode.Text>
								</barcode:SfBarcode>
								<TextBlock Text="Scan to Verify" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
							</StackPanel>
						</Border>
					</Grid>
				</Border>
			</DataTemplate>
			<x:Array Type="system:String" x:Key="ExcelVersions">
				<system:String>97 to 2003</system:String>
				<system:String>2007</system:String>
				<system:String>2010</system:String>
				<system:String>2013</system:String>
				<system:String>2016</system:String>
			</x:Array>
			<modules:AddValueConvertor x:Key="AddValueConvertor" />
			<Style x:Key="ListBoxNoHighlight" TargetType="ListBoxItem">
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="Transparent"/>
					</Trigger>
					<Trigger Property="IsSelected" Value="True">
						<Setter Property="Background" Value="Transparent"/>
					</Trigger>
				</Style.Triggers>
			</Style>
			<modules:ColorConverter x:Key="ColorConvertor"/>
			<modules:CollectionEmptyVisibilityConverter x:Key="CollectionEmptyVisibilityConverter"/>
			<modules:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>
			<modules:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
		</ResourceDictionary>
	</Application.Resources>
</prism:PrismApplication>
