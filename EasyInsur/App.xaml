<prism:PrismApplication x:Class="EasyInsur.App"
						xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						xmlns:hc="https://handyorg.github.io/handycontrol"
						xmlns:prism="http://prismlibrary.com/"
						xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
						xmlns:system="clr-namespace:System;assembly=System.Runtime"
						xmlns:modules="clr-namespace:EasyInsur.Modules"
						xmlns:barcode="clr-namespace:Syncfusion.UI.Xaml.Controls.Barcode;assembly=Syncfusion.SfBarcode.WPF">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<hc:ThemeResources/>
				<hc:Theme/>
				<!-- Other merged dictionaries here -->
				<ResourceDictionary Source="Models/SearchControl/Themes/Generic.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<!-- Other app resources here -->
			<Style x:Key="CellStyle" TargetType="Syncfusion:GridCell">
				<Setter Property="Background" Value="DarkGray"/>
			</Style>
			<modules:StringToImageConverter x:Key="StringToImageConverter"/>
