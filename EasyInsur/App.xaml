			<DataTemplate x:Key="DetailsViewTemplate">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="125"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="250"/>
						<ColumnDefinition/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>
					<Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="5" Height="150" Width="150" HorizontalAlignment="Left" 
				   Source="{Binding Path=Data.ImagePath, Converter={StaticResource StringToImageConverter}}" hc:ImageAttach.SourceFailed="Resources/no_image.jpg"/>
					<Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"
				   Margin="25,0,0,0" Content="Personal Details" FontWeight="Bold" />
					<StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="1" 
						HorizontalAlignment="Left" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal">
							<Label HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold"
						   Content="Name :"/>
							<TextBlock x:Name="NameText" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0} {1}">
										<Binding Path="Data.FirstName" />
										<Binding Path="Data.LastName" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<Label HorizontalAlignment="Left" VerticalAlignment="Center"
						   FontWeight="SemiBold" Content="Mobile No :"/>
							<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
							   Text="{Binding Data.Mobile}"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal">
							<Label HorizontalAlignment="Left" VerticalAlignment="Center"
						   FontWeight="SemiBold" Content="Email :"/>
							<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
							   Text="{Binding Data.Email}"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal">
							<Label HorizontalAlignment="Left" VerticalAlignment="Center"
						   FontWeight="SemiBold" Content="Registration Date :"/>
							<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
							   Text="{Binding Data.RegDate}"/>
						</StackPanel>
					</StackPanel>
					<Label Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" Margin="25,0,0,0"
				   Content="Transactions Details" FontWeight="Bold" />
					<StackPanel Orientation="Vertical" Grid.Column="2" Grid.Row="1" 
						HorizontalAlignment="Left" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal">
							<Label HorizontalAlignment="Right" VerticalAlignment="Center"
						   FontWeight="SemiBold" Content="Balance :"/>
							<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
							   Text="{Binding Data.Balance, StringFormat='{}{0:C}'}"/>
						</StackPanel>
						<barcode:SfBarcode x:Name="barcode" Symbology="QRBarcode" Height="120" Width="120" DisplayText="False">
							<barcode:SfBarcode.Text>
								<MultiBinding StringFormat="{}Name: {0}{2}Mobile: {1}{2}Email: {3}{2}Registration Date: {4}{2}Balance: {5:C}">
									<Binding Path="Text" ElementName="NameText" />
									<Binding Path="Data.Mobile" />
									<Binding Source="{x:Static system:Environment.NewLine}"/>
									<Binding Path="Data.Email" />
									<Binding Path="Data.RegDate" />
									<Binding Path="Data.Balance" />
								</MultiBinding>
							</barcode:SfBarcode.Text>
						</barcode:SfBarcode>
					</StackPanel>
				</Grid>
			</DataTemplate>
			<x:Array Type="system:String" x:Key="ExcelVersions">
				<system:String>97 to 2003</system:String>
				<system:String>2007</system:String>
				<system:String>2010</system:String>
				<system:String>2013</system:String>
				<system:String>2016</system:String>
			</x:Array>
			<modules:AddValueConvertor x:Key="AddValueConvertor" />
			<Style x:Key="ListBoxNoHighlight" TargetType="ListBoxItem">
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="Transparent"/>
					</Trigger>
					<Trigger Property="IsSelected" Value="True">
						<Setter Property="Background" Value="Transparent"/>
					</Trigger>
				</Style.Triggers>
			</Style>
			<modules:ColorConverter x:Key="ColorConvertor"/>
		</ResourceDictionary>
	</Application.Resources>
</prism:PrismApplication>
