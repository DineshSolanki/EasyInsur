<UserControl x:Class="EasyInsur.Views.Controls.ModernNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:modules="clr-namespace:EasyInsur.Modules"
             mc:Ignorable="d" 
             x:Name="NavItemRoot">
    <UserControl.Resources>
        <modules:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Button x:Name="ActionButton"
            Click="ActionButton_Click"
            FocusVisualStyle="{x:Null}"
            Cursor="Hand"
            Height="40"
            Margin="6,2"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            ToolTipService.InitialShowDelay="250">
        <Button.ToolTip>
            <ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title, ElementName=NavItemRoot}" FontWeight="SemiBold"/>
                    <TextBlock Text=" (" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding Shortcut, ElementName=NavItemRoot}" Foreground="#2563EB" FontWeight="Medium"/>
                    <TextBlock Text=")" Foreground="#6B7280"/>
                </StackPanel>
            </ToolTip>
        </Button.ToolTip>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <!-- Collapsed layout (Center Icon) -->
                        <Grid x:Name="CollapsedLayout" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Visibility="{Binding IsCollapsed, ElementName=NavItemRoot, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding Icon, ElementName=NavItemRoot}" 
                                   Width="20" Height="20" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <!-- Expanded layout (Left Bar + Icon + Label + Shortcut Pill) -->
                        <Grid x:Name="ExpandedLayout"
                              Visibility="{Binding IsCollapsed, ElementName=NavItemRoot, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left active indicator pill -->
                            <Border x:Name="ActivePill" 
                                    Grid.Column="0" 
                                    Width="3.5" 
                                    Height="18" 
                                    CornerRadius="1.75" 
                                    Background="Transparent" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center"/>

                            <!-- Icon -->
                            <Image Grid.Column="1" 
                                   Source="{Binding Icon, ElementName=NavItemRoot}" 
                                   Width="20" Height="20" 
                                   Margin="8,0,10,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Title -->
                            <TextBlock x:Name="TitleText" 
                                       Grid.Column="2" 
                                       Text="{Binding Title, ElementName=NavItemRoot}" 
                                       FontSize="13" 
                                       Foreground="#475569" 
                                       FontWeight="Medium" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Shortcut Badge -->
                            <Border x:Name="ShortcutBadge" 
                                    Grid.Column="3" 
                                    Margin="0,0,8,0" 
                                    Padding="5,1.5" 
                                    CornerRadius="4" 
                                    Background="#F1F5F9" 
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ShortcutText" 
                                           Text="{Binding Shortcut, ElementName=NavItemRoot}" 
                                           FontSize="10" 
                                           Foreground="#94A3B8" 
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <!-- Hover Trigger -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                        <Setter TargetName="TitleText" Property="Foreground" Value="#0F172A"/>
                    </Trigger>
                    <!-- Pressed Trigger -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#E2E8F0"/>
                    </Trigger>
                    <!-- Active State Trigger -->
                    <DataTrigger Binding="{Binding IsActive, ElementName=NavItemRoot}" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#DBEAFE"/>
                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                        <Setter TargetName="ActivePill" Property="Background" Value="#2563EB"/>
                        <Setter TargetName="TitleText" Property="Foreground" Value="#1D4ED8"/>
                        <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                        <Setter TargetName="ShortcutBadge" Property="Background" Value="#DBEAFE"/>
                        <Setter TargetName="ShortcutText" Property="Foreground" Value="#2563EB"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
