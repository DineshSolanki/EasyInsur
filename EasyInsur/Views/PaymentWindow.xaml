<UserControl xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             x:Class="EasyInsur.Views.PaymentWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:local="clr-namespace:EasyInsur.Modules"
             xmlns:viewmodels="clr-namespace:EasyInsur.ViewModels"
             xmlns:models="clr-namespace:EasyInsur.Models"
             syncfusionskin:SfSkinManager.VisualStyle="FluentLight"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewmodels:PaymentWindowViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#EFF6FF" />

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="1" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Form Cards (Payee & Breakdown & Settlement) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Transactions DataGrid Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                          Stroke="#2563EB" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Payment &amp; Transactions" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource SectionBadgeStyle}" Margin="10,0,0,0">
                            <TextBlock Text="Ledger Entry" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Record policy premiums, calculate commissions, and update customer or agent balances."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Primary Action Cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDefault}" Command="{Binding ResetCommand}" Height="34" Margin="0,0,8,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ReloadGeometry}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset Form" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SaveGeometry}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Save Transaction" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: COMPREHENSIVE FORM SECTION -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Basic & Payee Details -->
            <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                        </Border>
                        <TextBlock Text="Basic &amp; Payee Information" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="SR. No" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <hc:TextBox Text="{Binding SrNo}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="First Date" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                            </TextBlock>
                            <hc:DatePicker SelectedDateFormat="Short" SelectedDate="{Binding FirstDate}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                            <TextBlock Text="Payee Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <hc:ComboBox SelectedIndex="0" ItemsSource="{Binding Source={hc:EnumBindingSource {x:Type models:PersonType}}}" AutoComplete="True" SelectedItem="{Binding PayeeType}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,6,0">
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="Payee Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                            </TextBlock>
                            <hc:ComboBox SelectedIndex="0" ItemsSource="{Binding PayeeCollection}" SelectedItem="{Binding SelectedPayee}" ToolTip="{Binding SelectedPayee.PersonID}" AutoComplete="True" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,6,0">
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="Vehicle No." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                            </TextBlock>
                            <syncfusion:SfTextBoxExt SearchItemPath="VehicleNo" AutoCompleteSource="{Binding Insurance}" AutoCompleteMode="SuggestAppend" SuggestionMode="StartsWith" IgnoreCase="True" MinimumPrefixCharacters="1" MaximumSuggestionsCount="10" Text="{Binding VehicleNo}" Style="{StaticResource TextBoxExtend}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Margin="0,0,0,0">
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="Payment Date" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                            </TextBlock>
                            <hc:DatePicker SelectedDateFormat="Short" SelectedDate="{Binding PaymentDate}" Height="34"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Financial Calculation & Settlement (2-column layout) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Insurance Premium Breakdown -->
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="0,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Insurance Premium Breakdown" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Fixed Amount" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" Value="{Binding FixedAmount}" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="OD Amount" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" Value="{Binding ODAmount}" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="TP Amount" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" Value="{Binding TPAmount}" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                <TextBlock Text="Tax Amount" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" Value="{Binding TaxAmount}" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <!-- Highlighted Total Amount -->
                            <StackPanel Grid.Column="4" Margin="0,0,0,0">
                                <TextBlock Text="Total Amount" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34">
                                    <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" Value="{Binding TotalAmount}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E293B" CurrencyDecimalDigits="2" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right: Commission & Balance Settlement -->
                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="5,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                            <TextBlock Text="Commission &amp; Settlement Reconciliation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Commission Type & Value -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Commission" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <hc:ComboBox x:Name="Box" SelectedIndex="0" Text="{Binding CommissionType}" AutoComplete="True" Height="34">
                                    <ComboBoxItem Content="Amount"/>
                                    <ComboBoxItem Content="Percentage"/>
                                </hc:ComboBox>
                            </StackPanel>

                            <!-- Amount or Percentage mode -->
                            <Grid Grid.Column="1" Margin="0,0,6,0">
                                <StackPanel Visibility="{Binding IsPercentageSelected, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                    <TextBlock Text="Comm. Amount" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" Value="{Binding CommissionAmount}" CurrencyDecimalDigits="2" Height="34"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsPercentageSelected, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="OD %" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <syncfusion:PercentTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100" MinValidation="OnKeyPress" MaxValidation="OnKeyPress" PercentDecimalDigits="2" PercentValue="{Binding ODPercent}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="TP %" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <syncfusion:PercentTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100" MinValidation="OnKeyPress" MaxValidation="OnKeyPress" PercentDecimalDigits="2" PercentValue="{Binding TPPercent}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- After Commission -->
                            <StackPanel Grid.Column="2" Margin="0,0,0,0">
                                <TextBlock Text="Net (After Comm)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" IsReadOnly="True" Value="{Binding AmtAfterCommission}" CurrencyDecimalDigits="2" Height="34">
                                    <syncfusion:CurrencyTextBox.ToolTip>
                                        <ToolTip Content="{Binding Path=TotalCommission}" ContentStringFormat="{}Total Commission: {0:C}"/>
                                    </syncfusion:CurrencyTextBox.ToolTip>
                                </syncfusion:CurrencyTextBox>
                            </StackPanel>
                        </Grid>

                        <!-- Settlement Balances Ribbon -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Payment Received" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" MinValue="0" MaxValue="100000000" CurrencyDecimalDigits="2" Value="{Binding Payment}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Current Balance" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" Value="{Binding Balance}" IsReadOnly="True" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Previous Balance" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" Value="{Binding PreviousBalance}" IsReadOnly="True" CurrencyDecimalDigits="2" Height="34"/>
                            </StackPanel>

                            <!-- Final Balance badge/box -->
                            <StackPanel Grid.Column="3" Margin="0,0,0,0">
                                <TextBlock Text="Final Balance" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="6" Height="34">
                                    <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" Value="{Binding FinalBalance}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A" CurrencyDecimalDigits="2" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 2: TRANSACTIONS DATAGRID CARD -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="10">
            <DockPanel LastChildFill="True">
                <!-- Header inside DataGrid Card -->
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Recent Transactions History" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="Audit Ledger" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Footer: Rows per page selector & DataPager -->
                <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <hc:ComboBox x:Name="PageSizeCombo" SelectedIndex="1" Width="95" Height="26">
                                <ComboBoxItem Content="15 rows" Tag="15"/>
                                <ComboBoxItem Content="25 rows" Tag="25"/>
                                <ComboBoxItem Content="50 rows" Tag="50"/>
                                <ComboBoxItem Content="100 rows" Tag="100"/>
                            </hc:ComboBox>
                        </StackPanel>
                        <syncfusion:SfDataPager x:Name="SfDataPager"
                                                DockPanel.Dock="Right"
                                                NumericButtonCount="7"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                PageSize="{Binding ElementName=PageSizeCombo, Path=SelectedValue.Tag, FallbackValue=25, TargetNullValue=25}" 
                                                Source="{Binding Transactions}" />
                    </DockPanel>
                </Border>

                <!-- Grid & Empty Overlay -->
                <Grid>
                    <syncfusion:SfDataGrid AutoGenerateColumns="False" BorderThickness="1" BorderBrush="#E2E8F0"
                                           ItemsSource="{Binding ElementName=SfDataPager,Path=PagedSource}" AllowDraggingColumns="True"
                                           AllowFiltering="True" ColumnSizer="Star" AllowResizingColumns="True"
                                           ShowRowHeader="True" GridLinesVisibility="Horizontal" GridCopyOption="CopyData" SelectionUnit="Any"
                                           HeaderLinesVisibility="Both" ScrollMode="Async" AllowGrouping="True" ShowGroupDropArea="True" EnableDataVirtualization="True">
                        <syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ExpandAll" Header="Expand All" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ExpandAll}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M65.8418,72.2030999999999L63.4438,69.8030999999999L59.2608,73.9850999999999L57.2318,71.9561L61.4128,67.7761L59.0138,65.3750999999999L65.8418,65.3750999999999z M55.8888,82.2811L49.0608,82.2811L49.0608,75.4541L51.4588,77.8531L55.6428,73.6700999999999L57.6708,75.7000999999999L53.4888,79.8821z M45.4508,85.8280999999999L69.4508,85.8280999999999L69.4508,61.8280999999999L45.4508,61.8280999999999z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CollapseAll" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.CollapseAll}}"
                                          CommandParameter="{Binding}" Header="Collapse All">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M62.4873,119.8345L55.6593,119.8345L55.6593,113.0065L58.0573,115.4065L62.2403,111.2245L64.2693,113.2535L60.0883,117.4335z M54.2233,128.0975L51.8253,125.6985L47.6413,129.8805L45.6123,127.8515L49.7943,123.6695L47.3953,121.2705L54.2233,121.2705z M42.9413,132.5525L66.9413,132.5525L66.9413,108.5525L42.9413,108.5525z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="ClearGroups" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearGroups}}"
                                          CommandParameter="{Binding}" Header="Clear Groups" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                        <syncfusion:SfDataGrid.HeaderContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.SortAscending}}" CommandParameter="{Binding}" Header="Sort Ascending" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.SortDescending}}" CommandParameter="{Binding}" Header="Sort Descending" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearSorting}}" CommandParameter="{Binding}" Header="Clear Sorting" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearFiltering}}" CommandParameter="{Binding}" Header="Clear Filtering" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.GroupThisColumn}}" CommandParameter="{Binding}" Header="Group by this Column" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ShowHideGroupArea}}" CommandParameter="{Binding}" Header="Expand/Collapse Group Drop Area" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.BestFit}}" CommandParameter="{Binding}" Header="Best Fit" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.HeaderContextMenu>
                        <syncfusion:SfDataGrid.GroupCaptionContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Expand}}" CommandParameter="{Binding}" Header="Expand" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Collapse}}" CommandParameter="{Binding}" Header="Collapse" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupCaptionContextMenu>
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Copy}}" CommandParameter="{Binding}" Header="Copy" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.RecordContextMenu>
                        <syncfusion:SfDataGrid.StackedHeaderRows>
                            <syncfusion:StackedHeaderRow>
                                <syncfusion:StackedHeaderRow.StackedColumns>
                                    <syncfusion:StackedColumn ChildColumns="FixedAmount,OD,TP,Tax,TotalAmount" HeaderText="Insurance Amount"/>
                                    <syncfusion:StackedColumn ChildColumns="CommissionAmount,AfterCommissionAmount" HeaderText="Commission Details"/>
                                    <syncfusion:StackedColumn ChildColumns="Balance,PreviousBalance,FinalBalance" HeaderText="Balance Details"/>
                                </syncfusion:StackedHeaderRow.StackedColumns>
                            </syncfusion:StackedHeaderRow>
                        </syncfusion:SfDataGrid.StackedHeaderRows>
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" Position="Top">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="BalanceSum" Format="'Balance: {Sum:c}'" MappingName="FinalBalance" SummaryType="DoubleAggregate"/>
                                    <syncfusion:GridSummaryColumn Name="CommissionSum" Format="'Commission: {Sum:c}'" MappingName="CommissionAmount" SummaryType="DoubleAggregate" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Id" HeaderText="ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="Insurance.VehicleNo" HeaderText="Vehicle No." MinimumWidth="110"/>
                            <syncfusion:GridDateTimeColumn MappingName="Insurance.RegDate" HeaderText="Reg Date" MinimumWidth="90"/>
                            <syncfusion:GridDateTimeColumn MappingName="PaymentDate" HeaderText="Payment Date" MinimumWidth="90"/>
                            <syncfusion:GridCurrencyColumn MappingName="FixedAmount" HeaderText="Fixed Amount" MinimumWidth="85"/>
                            <syncfusion:GridCurrencyColumn MappingName="OD" HeaderText="OD" MinimumWidth="70"/>
                            <syncfusion:GridCurrencyColumn MappingName="TP" HeaderText="TP" MinimumWidth="70"/>
                            <syncfusion:GridCurrencyColumn MappingName="Tax" HeaderText="Tax" MinimumWidth="70"/>
                            <syncfusion:GridCurrencyColumn MappingName="CommissionAmount" HeaderText="Commission" MinimumWidth="85"/>
                            <syncfusion:GridCurrencyColumn MappingName="AfterCommissionAmount" HeaderText="Total - Comm" MinimumWidth="100"/>
                            <syncfusion:GridCurrencyColumn MappingName="Payment" HeaderText="Payment" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="Balance" HeaderText="Balance" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="PreviousBalance" HeaderText="Prev Balance" MinimumWidth="85"/>
                            <syncfusion:GridCurrencyColumn MappingName="FinalBalance" HeaderText="Final Balance" MinimumWidth="85">
                                <syncfusion:GridCurrencyColumn.CellStyle>
                                    <Style TargetType="syncfusion:GridCell">
                                        <Setter Property="Background" Value="{Binding FinalBalance, Converter={StaticResource ColorConvertor}}" />
                                    </Style>
                                </syncfusion:GridCurrencyColumn.CellStyle>
                            </syncfusion:GridCurrencyColumn>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <hc:Empty Description="No transaction records found for the selected payee."
                              Visibility="{Binding Transactions, Converter={StaticResource CollectionEmptyVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
