<UserControl x:Class="EasyInsur.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:EasyInsur.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:DashboardViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <DockPanel Margin="10" LastChildFill="True">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Viewbox HorizontalAlignment="Right">
                        <Image Source="../Resources/noProfile.png" Stretch="None" />
                    </Viewbox>
                </Grid>
                <Border Grid.Column="1">
                    <Viewbox
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="22"
                                Text="Agency Owner Name" />
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="16"
                                FontWeight="Light"
                                Text="Phone  : 0000000000" />
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="16"
                                FontWeight="Light"
                                Text="Email    : owner@example.com" />
                        </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>
            <Border
                Grid.Column="1"
                Margin="10,10,0,0"
                BorderBrush="#B2B2B2"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#B2B2B2" BorderThickness="0,0,1,0">
                        <Viewbox
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <hc:OutlineText Fill="{DynamicResource SuccessBrush}"
                                                Margin="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding CustomersCount}" />
                                <TextBlock
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customers" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                    <Border Grid.Column="1">
                        <Viewbox
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">

                                <hc:OutlineText Fill="{DynamicResource InfoBrush}"
                                                Margin="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding AgentsCount}" />

                                <TextBlock
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Agents" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                    <Border
                        Grid.Column="2"
                        BorderBrush="#B2B2B2"
                        BorderThickness="1,0,0,0">
                        <Viewbox
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">

                                <hc:OutlineText Fill="{StaticResource DarkSuccessBrush}"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding TotalPeople}" />
                                <TextBlock
                                    Margin="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Total Registered People" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <hc:SimpleStackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="10">
            <hc:SimpleStackPanel Margin="5"
                                 Orientation="Horizontal" HorizontalAlignment="Center">

                <Image Source="../Resources/link.png"
                       Height="30" />
                <hc:SimpleText  FontFamily="Aerial" FontSize="20" MaxWidth="150" Text="Useful links" 
                                VerticalAlignment="Bottom" />
            </hc:SimpleStackPanel>
            <ListBox ItemsSource="{Binding Links}" DisplayMemberPath="Key">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <hc:LaunchUriOrFileAction Path="{Binding SelectedItem.Value,RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
           <hc:ScrollViewer VerticalScrollBarVisibility="Visible" Orientation="Vertical" CanContentScroll="True" Height="300">
               <Grid>
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                   </Grid.RowDefinitions>
                   <syncfusion:SfCalculator Grid.Row="0"/>
            <GroupBox Grid.Row="1" Header="Developed By" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <hc:SimpleText  FontFamily="Aerial" FontSize="16" MaxWidth="150" HorizontalAlignment="Center"
                                    Text="Dinesh Solanki" />
                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Source="../Resources/email.png"
                               Height="25" />
                        <hc:SimpleText Grid.Column="1"  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="GitHub" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="mailto:redacted@example.com?subject=FROM_EASYInsure" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </Grid>
                    <Grid Grid.Row="2" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Source="../Resources/website.png"
                               Height="25" />
                        <hc:SimpleText Grid.Column="1"  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="Aprogrammers" ToolTip="https://aprogrammers.wordpress.com/" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="https://aprogrammers.wordpress.com/" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </Grid>
                    <Grid Grid.Row="3" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Source="../Resources/telegram.png"
                               Height="25" />
                        <hc:SimpleText Grid.Column="1"  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="GitHub Issues" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="https://GitHub Issues" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </Grid>
                </Grid>
            </GroupBox>
               </Grid>
           </hc:ScrollViewer>
        </hc:SimpleStackPanel>
        <ContentControl Background="White" Style="{StaticResource LiveStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
</UserControl>