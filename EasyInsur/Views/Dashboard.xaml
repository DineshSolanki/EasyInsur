<UserControl x:Class="EasyInsur.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <DockPanel>
        <hc:SimpleStackPanel DockPanel.Dock="Top">
            <TextBlock  Text="Ram Riya Fin. Corp." FontFamily="Pristina" FontSize="30"
                        hc:TextBlockAttach.AutoTooltip="True" TextAlignment="Center" />
            <hc:SimpleStackPanel Margin="5"
                                 Orientation="Horizontal">

                <Image Source="../Resources/man.png"
                       Height="30" />
                <TextBlock  Text="Mukesh Tanwar" FontFamily="High Tower Text" FontSize="20"
                            hc:TextBlockAttach.AutoTooltip="True" />
            </hc:SimpleStackPanel>
            <hc:SimpleStackPanel Margin="5"
                                 Orientation="Horizontal">

                <Image Source="../Resources/phone.png"
                           Height="30" />
                <TextBlock  Text="7611007209" FontFamily="High Tower Text" FontSize="20"
                                hc:TextBlockAttach.AutoTooltip="True" />
            </hc:SimpleStackPanel>
            <hc:SimpleStackPanel Margin="5"
                                 Orientation="Horizontal">

                <Image Source="../Resources/email.png"
                       Height="30" />
                <TextBlock  Text="MukeshTanwarjlr@gmail.com" FontFamily="High Tower Text" FontSize="28"
                            hc:TextBlockAttach.AutoTooltip="True" />
            </hc:SimpleStackPanel>
        </hc:SimpleStackPanel>
        <hc:SimpleStackPanel DockPanel.Dock="Right">
            <GroupBox Header="Data summaries" Margin="5">
                <hc:SimpleStackPanel>
                    <hc:SimpleStackPanel Margin="5"
                                       Orientation="Horizontal">

                        <Image Source="../Resources/customer.png"
                             Height="30" />
                        <hc:SimpleText  FontFamily="High Tower Text" FontSize="16"
                                       VerticalAlignment="Bottom">
                            <hc:SimpleText.Text>
                                <MultiBinding StringFormat="{}Customers: {0}">
                                    <Binding Path="CustomersCount" />
                                </MultiBinding>
                            </hc:SimpleText.Text>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                    <hc:SimpleStackPanel Margin="5"
                                       Orientation="Horizontal">

                        <Image Source="../Resources/agent.png"
                             Height="30" />
                        <hc:SimpleText  FontFamily="High Tower Text" FontSize="16"
                                        VerticalAlignment="Bottom">
                            <hc:SimpleText.Text>
                                <MultiBinding StringFormat="{}Agents: {0}">
                                    <Binding Path="AgentsCount" />
                                </MultiBinding>
                            </hc:SimpleText.Text>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                    <hc:SimpleStackPanel Margin="5"
                                       Orientation="Horizontal">

                        <Image Source="../Resources/people.png"
                             Height="30" />
                        <hc:SimpleText  FontFamily="High Tower Text" FontSize="16"
                                        VerticalAlignment="Bottom">
                            <hc:SimpleText.Text>
                                <MultiBinding Converter="{StaticResource AddValueConvertor}">
                                    <Binding Path="AgentsCount" />
                                    <Binding Path="CustomersCount" />
                                </MultiBinding>
                            </hc:SimpleText.Text>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                </hc:SimpleStackPanel>
            </GroupBox>
            <hc:SimpleStackPanel Margin="5"
                                 Orientation="Horizontal" HorizontalAlignment="Center">

                <Image Source="../Resources/link.png"
                       Height="30" />
                <hc:SimpleText  FontFamily="Aerial" FontSize="20" MaxWidth="150" Text="Useful links" 
                                VerticalAlignment="Bottom" />
            </hc:SimpleStackPanel>
            <ListBox ItemsSource="{Binding Links}" DisplayMemberPath="Key">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <hc:LaunchUriOrFileAction Path="{Binding SelectedItem.Value,RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
            <GroupBox Header="Developed By" Margin="5" HorizontalAlignment="Stretch">
                <hc:SimpleStackPanel>
                    <hc:SimpleText  FontFamily="Aerial" FontSize="16" MaxWidth="150" HorizontalAlignment="Center"
                                    Text="Dinesh Solanki" />
                    <hc:SimpleStackPanel Margin="5"
                                         Orientation="Horizontal">

                        <Image Source="../Resources/email.png"
                               Height="25" />
                        <hc:SimpleText  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="solankid297@gmail.com" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="mailto:solankid297@gmail?subject=FROM_EASYInsure" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                    <hc:SimpleStackPanel Margin="5"
                                         Orientation="Horizontal">

                        <Image Source="../Resources/website.png"
                               Height="25" />
                        <hc:SimpleText  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="Aprogrammers" ToolTip="https://aprogrammers.wordpress.com/" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="https://aprogrammers.wordpress.com/" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                    <hc:SimpleStackPanel Margin="5"
                                         Orientation="Horizontal">

                        <Image Source="../Resources/telegram.png"
                               Height="25" />
                        <hc:SimpleText  FontFamily="Aerial" FontSize="16"
                                        hc:TextBlockAttach.AutoTooltip="True" Text="t.me/Dinesh_Solanki" VerticalAlignment="Bottom">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="MouseDown">
                                    <hc:LaunchUriOrFileAction Path="https://t.me/dinesh_solanki" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:SimpleText>
                    </hc:SimpleStackPanel>
                </hc:SimpleStackPanel>
            </GroupBox>
        </hc:SimpleStackPanel>
        <hc:SimpleStackPanel DockPanel.Dock="Bottom">
        </hc:SimpleStackPanel>
    </DockPanel>
</UserControl>