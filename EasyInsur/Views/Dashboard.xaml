<UserControl x:Class="EasyInsur.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:EasyInsur.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:DashboardViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             syncfusionskin:SfSkinManager.VisualStyle="FluentLight">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MetricCardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MetricBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentGreen" Color="#059669" />
        <SolidColorBrush x:Key="AccentPurple" Color="#7C3AED" />
        <SolidColorBrush x:Key="AccentAmber" Color="#D97706" />

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MetricCardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetricBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="1" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionCardButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Summary Metric Cards -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area: Left Recent Activity & Right Tools/Links -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Agency Profile & Refresh Action -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Profile Avatar -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <Image Source="../Resources/broker_32.png" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Agency Information -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OwnerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EasyInsur Agency" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding OwnerPhone, StringFormat='{}📞 {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding OwnerEmail, StringFormat='{}✉ {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Refresh & Status Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Right">
                        <TextBlock Text="Last refreshed" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Style="{StaticResource ButtonPrimary}" Padding="10,6" Command="{Binding RefreshCommand}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Resources/clear.png" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STAT METRIC CARDS ROW -->
        <Grid Grid.Row="1" Margin="-4,0,-4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="130" />
                <ColumnDefinition Width="*" MinWidth="130" />
                <ColumnDefinition Width="*" MinWidth="130" />
                <ColumnDefinition Width="*" MinWidth="130" />
                <ColumnDefinition Width="*" MinWidth="130" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Premium -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TOTAL PREMIUM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <Image Source="../Resources/money.png" Width="18" Height="18" HorizontalAlignment="Right" Opacity="0.7" />
                    </Grid>
                    <TextBlock Text="{Binding TotalPremium, StringFormat='{}₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,6,0,2" />
                    <TextBlock Text="{Binding TransactionCount, StringFormat='{}{0} policies recorded'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Total Commission -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="EARNED COMMISSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <Image Source="../Resources/rupee.png" Width="18" Height="18" HorizontalAlignment="Right" Opacity="0.7" />
                    </Grid>
                    <TextBlock Text="{Binding TotalCommission, StringFormat='{}₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,2" />
                    <TextBlock Text="Total commission earned" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Outstanding Balance -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TOTAL BALANCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <Image Source="../Resources/payment_history.png" Width="18" Height="18" HorizontalAlignment="Right" Opacity="0.7" />
                    </Grid>
                    <TextBlock Text="{Binding TotalBalance, StringFormat='{}₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,2" />
                    <TextBlock Text="Payee ledger balance" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Customers Count -->
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="CUSTOMERS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <Image Source="../Resources/customer.png" Width="18" Height="18" HorizontalAlignment="Right" Opacity="0.7" />
                    </Grid>
                    <TextBlock Text="{Binding CustomersCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,2" />
                    <TextBlock Text="Active client profiles" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Card 5: Agents & Network -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="AGENTS / BROKERS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <Image Source="../Resources/agent.png" Width="18" Height="18" HorizontalAlignment="Right" Opacity="0.7" />
                    </Grid>
                    <TextBlock Text="{Binding AgentsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,6,0,2" />
                    <TextBlock Text="{Binding TotalPeople, StringFormat='{}{0} total network size'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Responsive Recent Activity Feed Table -->
                <ColumnDefinition Width="7*" MinWidth="480" />
                <!-- Right: Operations, Calculator & Portals -->
                <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Recent Activity Feed using Syncfusion SfDataGrid (Fully Responsive) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Recent Transactions" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#F3F4F6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding RecentActivities.Count, StringFormat='{}Latest {0}', FallbackValue='Recent'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource ButtonDefault}" Padding="8,4" HorizontalAlignment="Right"
                                Command="{Binding NavigateCommand}" CommandParameter="ViewPaymentWindow" Cursor="Hand">
                            <TextBlock Text="View All Payments ➔" FontSize="11" />
                        </Button>
                    </Grid>

                    <syncfusion:SfDataGrid Grid.Row="1"
                                           ItemsSource="{Binding RecentActivities}"
                                           AutoGenerateColumns="False"
                                           AllowResizingColumns="True"
                                           AllowSorting="True"
                                           ColumnSizer="Star"
                                           SelectionMode="Single"
                                           NavigationMode="Row"
                                           RowHeight="34"
                                           HeaderRowHeight="36">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Id" HeaderText="ID" ColumnSizer="Auto" MinimumWidth="50" TextAlignment="Center" />
                            <syncfusion:GridTextColumn MappingName="PaymentDate" HeaderText="Date" ColumnSizer="Auto" MinimumWidth="95" TextAlignment="Center" />
                            <syncfusion:GridTextColumn MappingName="PayeeName" HeaderText="Payee" MinimumWidth="160" />
                            <syncfusion:GridTextColumn MappingName="PayeeType" HeaderText="Role" ColumnSizer="Auto" MinimumWidth="80" TextAlignment="Center" />
                            <syncfusion:GridTextColumn MappingName="VehicleNo" HeaderText="Vehicle" MinimumWidth="100" TextAlignment="Center" />
                            <syncfusion:GridCurrencyColumn MappingName="TotalAmount" HeaderText="Total" MinimumWidth="100" CurrencySymbol="₹" TextAlignment="Right" />
                            <syncfusion:GridCurrencyColumn MappingName="CommissionAmount" HeaderText="Commission" MinimumWidth="100" CurrencySymbol="₹" TextAlignment="Right" />
                            <syncfusion:GridCurrencyColumn MappingName="Balance" HeaderText="Balance" MinimumWidth="95" CurrencySymbol="₹" TextAlignment="Right" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Quick Actions & Responsive Calculator & Portals -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Quick Actions Section -->
                        <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />

                        <!-- Add Payment Action -->
                        <Button Style="{StaticResource ActionCardButton}" Command="{Binding NavigateCommand}" CommandParameter="PaymentWindow">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" Margin="0,0,10,0">
                                    <Image Source="../Resources/rupee.png" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="New Payment Entry" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Record premium &amp; commission" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Add Person Action -->
                        <Button Style="{StaticResource ActionCardButton}" Command="{Binding NavigateCommand}" CommandParameter="PersonDetails">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#F0FDF4" Margin="0,0,10,0">
                                    <Image Source="../Resources/add_people.png" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Register Person" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Add customer or agent profile" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Manage People Action -->
                        <Button Style="{StaticResource ActionCardButton}" Command="{Binding NavigateCommand}" CommandParameter="ViewPeopleWindow" Margin="0,0,0,12">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#FAF5FF" Margin="0,0,10,0">
                                    <Image Source="../Resources/people.png" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Customer &amp; Agent Directory" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Search, view ledgers &amp; export" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Quick Calculator Section (Official Syncfusion SfCalculator) -->
                        <TextBlock Text="Quick Calculator" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                            <syncfusion:SfCalculator Height="260"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     syncfusionskin:SfSkinManager.VisualStyle="FluentLight" />
                        </Border>

                        <!-- Official Insurance Portals -->
                        <TextBlock Text="Official Insurance Portals" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Links}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ActionCardButton}" Margin="0,0,0,6"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="../Resources/link.png" Width="14" Height="14" Margin="0,0,8,0" Opacity="0.7" />
                                            <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="{StaticResource AccentBlue}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Footer Info -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="EasyInsur Desktop" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Modernized for .NET 10 &amp; Syncfusion v35" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ButtonDefault}" Padding="6,2" FontSize="10"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/DineshSolanki/EasyInsur">
                                    <TextBlock Text="GitHub" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>