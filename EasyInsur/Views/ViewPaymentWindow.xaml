<UserControl x:Class="EasyInsur.Views.ViewPaymentWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:ViewPaymentWindowViewModel}"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:EasyInsur.ViewModels"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:local="clr-namespace:EasyInsur.Models"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:modules="clr-namespace:EasyInsur.Modules"
             prism:ViewModelLocator.AutoWireViewModel="True"
             syncfusion:SfSkinManager.VisualStyle="FluentLight">

    <UserControl.Resources>
        <local:CellStyleSelector x:Key="CellStyleSelector" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="1" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header & Filters Card -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Collapsible Export Options -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Transactions DataGrid Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER & CONTROLS CARD -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title, Badge & Primary Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
                              Stroke="#2563EB" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Transactions Ledger" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Style="{StaticResource SectionBadgeStyle}" Margin="10,0,0,0">
                                <TextBlock Text="Full Ledger" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Search, inspect, inline-edit, and export customer and agent transaction records."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right Actions: Reload & Save -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonDefault}" Command="{Binding ReloadCommand}" Height="34" Margin="0,0,8,0" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ReloadGeometry}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Reload" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SaveGeometry}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Save Changes" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Filters & Search Toolbar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Person Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <hc:ComboBox ItemsSource="{Binding Source={hc:EnumBindingSource {x:Type local:PersonType}}}"
                                     SelectedItem="{Binding PersonType}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Payee Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <hc:ComboBox SelectedIndex="0" ItemsSource="{Binding PayeeCollection}" SelectedItem="{Binding SelectedPayee}"
                                     ToolTip="{Binding SelectedPayee.PersonID}" AutoComplete="True"
                                     IsEditable="True" Style="{StaticResource ComboBoxExtendBaseStyle}" hc:DropDownElement.AutoWidth="True" Height="34"/>
                    </StackPanel>

                    <!-- Search Bar -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Search Ledger" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <hc:SearchBar x:Name="SearchBarForGrid" SearchStarted="SearchBar_OnSearchStarted"
                                      ShowClearButton="True"
                                      hc:InfoElement.Placeholder="Search transactions by vehicle, amount, date..."
                                      Style="{StaticResource SearchBarPlusBaseStyle}" IsRealTime="True" Height="34"/>
                    </StackPanel>

                    <!-- Export Toggle Button -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <ToggleButton x:Name="ExportToggle" Height="34" Padding="14,0"
                                      Style="{StaticResource ToggleButtonDefault}"
                                      Content="Export Data ▾" ToolTip="Show Excel and PDF Export Options"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 1: COLLAPSIBLE EXPORT CARD -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="0,0,0,8"
                Visibility="{Binding IsChecked, ElementName=ExportToggle, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Excel Options -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="XLSX" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                        </Border>
                        <TextBlock Text="Excel Export Preferences" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="AllowOutlining" Margin="2,3" Content="Allow Outlining (Group Hierarchies)" IsChecked="True" ToolTip="Enables expand/collapse groups in Excel sheet"/>
                    <CheckBox x:Name="ExportCurrentPageOnly" Margin="2,3" Content="Export current page only" IsChecked="True" ToolTip="Export current page only or all pages"/>
                    <CheckBox x:Name="ShowStackedHeader" Margin="2,3" Content="Include stacked headers" IsChecked="True" ToolTip="Exports multi-level grouped headers"/>
                </StackPanel>

                <!-- PDF Options -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#B91C1C"/>
                        </Border>
                        <TextBlock Text="PDF Export Preferences" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="ExportFormatted" Margin="2,3" Content="Export with formatting &amp; styles" IsChecked="True"/>
                    <CheckBox x:Name="FitOnOnePage" Margin="2,3" Content="Fit all columns on single page width" IsChecked="True"/>
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                        <TextBlock Text="Orientation:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <RadioButton x:Name="RadioLandscape" GroupName="Orientation" IsChecked="True" Margin="0,0,8,0" Content="Landscape"/>
                        <RadioButton x:Name="RadioPortrait" GroupName="Orientation" IsChecked="False" Content="Portrait"/>
                    </StackPanel>
                </StackPanel>

                <!-- Export Action Buttons -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="150">
                    <Button Style="{StaticResource ButtonDefault}" Margin="0,0,0,6" Height="32" Click="ExportExcelButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 Export to Excel" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDefault}" Height="32" Click="ExportPDFButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 Export to PDF" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: TRANSACTIONS DATAGRID CARD -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="10">
            <DockPanel LastChildFill="True">
                <!-- Pagination Footer -->
                <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <hc:ComboBox x:Name="PageSizeCombo" SelectedIndex="1" Width="95" Height="26">
                                <ComboBoxItem Content="15 rows" Tag="15"/>
                                <ComboBoxItem Content="25 rows" Tag="25"/>
                                <ComboBoxItem Content="50 rows" Tag="50"/>
                                <ComboBoxItem Content="100 rows" Tag="100"/>
                            </hc:ComboBox>
                        </StackPanel>
                        <syncfusion:SfDataPager x:Name="SfDataPager"
                                                DockPanel.Dock="Right"
                                                NumericButtonCount="7"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                PageSize="{Binding ElementName=PageSizeCombo, Path=SelectedValue.Tag, FallbackValue=25, TargetNullValue=25}" 
                                                Source="{Binding Transactions}" />
                    </DockPanel>
                </Border>

                <!-- DataGrid & Empty State Overlay -->
                <Grid>
                    <syncfusion:SfSmartDataGrid x:Name="DataGrid" BorderThickness="1" BorderBrush="#E2E8F0" AutoGenerateColumns="False"
                                                ItemsSource="{Binding ElementName=SfDataPager,Path=PagedSource}" AllowDraggingColumns="True"
                                                AllowFiltering="True" AllowSorting="True" ColumnSizer="Star" AllowResizingColumns="True"
                                                ShowRowHeader="True" GridLinesVisibility="Horizontal" GridCopyOption="CopyData" SelectionUnit="Any"
                                                HeaderLinesVisibility="Both" ScrollMode="Async" ShowGroupDropArea="True" LiveDataUpdateMode="AllowDataShaping"
                                                EnableDataVirtualization="True" CurrentCellValueChanged="DataGrid_OnCurrentCellValueChanged"
                                                CellStyleSelector="{StaticResource CellStyleSelector}" AllowEditing="True"
                                                EditorSelectionBehavior="MoveLast" GridValidationMode="InEdit"
                                                EnableSmartActions="True"
                                                Prompt="Try: group by VehicleNo"
                                                Suggestions="{Binding AiSuggestions}"
                                                HighlightBrush="LightYellow">
                        <syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ExpandAll" Header="Expand All" Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.ExpandAll}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M65.8418,72.2030999999999L63.4438,69.8030999999999L59.2608,73.9850999999999L57.2318,71.9561L61.4128,67.7761L59.0138,65.3750999999999L65.8418,65.3750999999999z M55.8888,82.2811L49.0608,82.2811L49.0608,75.4541L51.4588,77.8531L55.6428,73.6700999999999L57.6708,75.7000999999999L53.4888,79.8821z M45.4508,85.8280999999999L69.4508,85.8280999999999L69.4508,61.8280999999999L45.4508,61.8280999999999z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CollapseAll" Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.CollapseAll}}"
                                          CommandParameter="{Binding}" Header="Collapse All">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M62.4873,119.8345L55.6593,119.8345L55.6593,113.0065L58.0573,115.4065L62.2403,111.2245L64.2693,113.2535L60.0883,117.4335z M54.2233,128.0975L51.8253,125.6985L47.6413,129.8805L45.6123,127.8515L49.7943,123.6695L47.3953,121.2705L54.2233,121.2705z M42.9413,132.5525L66.9413,132.5525L66.9413,108.5525L42.9413,108.5525z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="ClearGroups" Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.ClearGroups}}"
                                          CommandParameter="{Binding}" Header="Clear Groups" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                        <syncfusion:SfDataGrid.HeaderContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.SortAscending}}" CommandParameter="{Binding}" Header="Sort Ascending" />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.SortDescending}}" CommandParameter="{Binding}" Header="Sort Descending" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.ClearSorting}}" CommandParameter="{Binding}" Header="Clear Sorting" />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.ClearFiltering}}" CommandParameter="{Binding}" Header="Clear Filtering" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.GroupThisColumn}}" CommandParameter="{Binding}" Header="Group by this Column" />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.ShowHideGroupArea}}" CommandParameter="{Binding}" Header="Expand/Collapse Group Drop Area" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.BestFit}}" CommandParameter="{Binding}" Header="Best Fit" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.HeaderContextMenu>
                        <syncfusion:SfDataGrid.GroupCaptionContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.Expand}}" CommandParameter="{Binding}" Header="Expand" />
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.Collapse}}" CommandParameter="{Binding}" Header="Collapse" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupCaptionContextMenu>
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.Copy}}" CommandParameter="{Binding}" Header="Copy" />
                                <MenuItem Command="{Binding DataGrid.DataContext.AddPayment}" CommandParameter="{Binding}" Header="Add Payment" />
                                <Separator />
                                <MenuItem Command="{Binding DataGrid.DataContext.DeleteTransactionCommand}" CommandParameter="{Binding}" Header="Delete Record">
                                    <MenuItem.Icon>
                                        <Grid Height="16" Width="16">
                                            <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z"
                                                  Fill="#D32F2F" Stretch="Uniform" />
                                        </Grid>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </syncfusion:SfDataGrid.RecordContextMenu>
                        <syncfusion:SfDataGrid.StackedHeaderRows>
                            <syncfusion:StackedHeaderRow>
                                <syncfusion:StackedHeaderRow.StackedColumns>
                                    <syncfusion:StackedColumn ChildColumns="FixedAmount,OD,TP,Tax,TotalAmount" HeaderText="Insurance Amount"/>
                                    <syncfusion:StackedColumn ChildColumns="CommissionAmount,AfterCommissionAmount" HeaderText="Commission Details"/>
                                    <syncfusion:StackedColumn ChildColumns="Balance,PreviousBalance,FinalBalance" HeaderText="Balance Details"/>
                                </syncfusion:StackedHeaderRow.StackedColumns>
                            </syncfusion:StackedHeaderRow>
                        </syncfusion:SfDataGrid.StackedHeaderRows>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Id" HeaderText="ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="Insurance.VehicleNo" HeaderText="Vehicle No." MinimumWidth="110"/>
                            <syncfusion:GridDateTimeColumn MappingName="Insurance.RegDate" HeaderText="Reg Date" MinimumWidth="90"/>
                            <syncfusion:GridDateTimeColumn MappingName="PaymentDate" HeaderText="Payment Date" MinimumWidth="90"/>
                            <syncfusion:GridCurrencyColumn MappingName="FixedAmount" HeaderText="Fixed" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="OD" HeaderText="OD" MinimumWidth="65"/>
                            <syncfusion:GridCurrencyColumn MappingName="TP" HeaderText="TP" MinimumWidth="65"/>
                            <syncfusion:GridCurrencyColumn MappingName="Tax" HeaderText="Tax" MinimumWidth="65"/>
                            <syncfusion:GridCurrencyColumn MappingName="CommissionAmount" HeaderText="Commission" MinimumWidth="85"/>
                            <syncfusion:GridCurrencyColumn MappingName="AfterCommissionAmount" HeaderText="Total - Comm" MinimumWidth="110"/>
                            <syncfusion:GridCurrencyColumn MappingName="Payment" HeaderText="Payment" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="Balance" HeaderText="Balance" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="PreviousBalance" HeaderText="Previous" MinimumWidth="80"/>
                            <syncfusion:GridCurrencyColumn MappingName="FinalBalance" HeaderText="Final Balance" MinimumWidth="85">
                                <syncfusion:GridCurrencyColumn.CellStyle>
                                    <Style TargetType="syncfusion:GridCell">
                                        <Setter Property="Background" Value="{Binding FinalBalance, Converter={StaticResource ColorConvertor}}" />
                                    </Style>
                                </syncfusion:GridCurrencyColumn.CellStyle>
                            </syncfusion:GridCurrencyColumn>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfSmartDataGrid>

                    <hc:Empty Description="No transaction records found matching the filter criteria."
                              Visibility="{Binding Transactions, Converter={StaticResource CollectionEmptyVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
