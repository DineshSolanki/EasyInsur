<UserControl x:Class="EasyInsur.Views.InsuranceWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:modules="clr-namespace:EasyInsur.Modules"
             syncfusionskin:SfSkinManager.VisualStyle="FluentLight"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="1" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Vehicle Entry Form Card -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Vehicle Inventory DataGrid Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z M5 17h10m4 0h1a1 1 0 001-1v-4.5a2 2 0 00-.59-1.41L18 7.5a2 2 0 00-1.41-.5H14V5a2 2 0 00-2-2H4a2 2 0 00-2 2v11a1 1 0 001 1h2"
                          Stroke="#2563EB" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vehicles &amp; Policies" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource SectionBadgeStyle}" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TotalInsurancesCount, StringFormat='{}{0} Registered Vehicles'}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage vehicle policy registrations, coverage valuation amounts, and effective policy dates."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Right Action: Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDefault}" Command="{Binding ReloadCommand}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ReloadGeometry}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: VEHICLE REGISTRATION FORM CARD -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                    </Border>
                    <TextBlock Text="Policy &amp; Vehicle Registration" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <hc:TextBox Grid.Column="0" Text="{Binding VehicleNo, UpdateSourceTrigger=PropertyChanged}" 
                                hc:TitleElement.Title="Vehicle Number" hc:TitleElement.TitlePlacement="Top"
                                hc:InfoElement.Necessary="True" hc:InfoElement.Placeholder="e.g. MH02AB1234" Height="32" Margin="0,0,10,0"/>

                    <hc:DatePicker Grid.Column="1" SelectedDate="{Binding RegDate, UpdateSourceTrigger=PropertyChanged}" 
                                   hc:TitleElement.Title="Registration Date" hc:TitleElement.TitlePlacement="Top"
                                   Height="32" Margin="0,0,10,0"/>

                    <syncfusion:CurrencyTextBox Grid.Column="2" Style="{StaticResource TextBoxExtend}"
                                                Value="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" 
                                                hc:TitleElement.Title="Insured Valuation" hc:TitleElement.TitlePlacement="Top"
                                                Height="32" CurrencyDecimalDigits="2" MinValue="0" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,21,0,0">
                        <Button Style="{StaticResource ButtonDefault}" Command="{Binding ResetCommand}" 
                                Content="Reset" Height="32" Margin="0,0,6,0" Padding="12,0"/>
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" 
                                Content="Add Vehicle" Height="32" Padding="14,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 2: VEHICLE INVENTORY DATAGRID CARD -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="10">
            <DockPanel LastChildFill="True">
                <!-- DataGrid Header -->
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Registered Vehicle Policies" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="Policy Ledger" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Pagination Footer -->
                <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <hc:ComboBox x:Name="PageSizeCombo" SelectedIndex="1" Width="95" Height="26">
                                <ComboBoxItem Content="15 rows" Tag="15"/>
                                <ComboBoxItem Content="25 rows" Tag="25"/>
                                <ComboBoxItem Content="50 rows" Tag="50"/>
                                <ComboBoxItem Content="100 rows" Tag="100"/>
                            </hc:ComboBox>
                        </StackPanel>
                        <syncfusion:SfDataPager x:Name="DataPager" DockPanel.Dock="Right"
                                                PageSize="{Binding SelectedItem.Tag, ElementName=PageSizeCombo, FallbackValue=25}"
                                                Source="{Binding Insurances}"
                                                NumericButtonCount="7"
                                                Height="30"
                                                HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- DataGrid & Empty State Overlay -->
                <Grid>
                    <syncfusion:SfDataGrid x:Name="DataGrid" BorderThickness="1" BorderBrush="#E2E8F0"
                                           ItemsSource="{Binding ElementName=DataPager, Path=PagedSource}"
                                           SelectedItem="{Binding SelectedInsurance, Mode=TwoWay}"
                                           AutoGenerateColumns="False"
                                           AllowFiltering="True"
                                           AllowSorting="True"
                                           AllowResizingColumns="True"
                                           ColumnSizer="Star"
                                           SelectionMode="Single"
                                           SelectionUnit="Row"
                                           ShowRowHeader="True"
                                           GridLinesVisibility="Horizontal"
                                           ScrollMode="Async">
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.Copy}}"
                                          CommandParameter="{Binding}"
                                          Header="Copy">
                                    <MenuItem.Icon>
                                        <Grid Height="16" Width="16">
                                            <Path Data="M5.5000009,2.500005 L10.500001,2.500005 14.500001,6.500005 14.500001,14.500005 5.5000009,14.500005 z M0,0 L4.0000037,0 4.0000037,12 0,12 z" 
                                                  Fill="#FF3A3939" Stretch="Fill"/>
                                        </Grid>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding DataGrid.DataContext.DeleteInsuranceCommand}"
                                          CommandParameter="{Binding}"
                                          Header="Delete Record">
                                    <MenuItem.Icon>
                                        <Grid Height="16" Width="16">
                                            <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z"
                                                  Fill="#D32F2F" Stretch="Uniform"/>
                                        </Grid>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </syncfusion:SfDataGrid.RecordContextMenu>

                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Id" HeaderText="Policy ID" Width="90"/>
                            <syncfusion:GridTextColumn MappingName="VehicleNo" HeaderText="Vehicle Number" MinimumWidth="150"/>
                            <syncfusion:GridDateTimeColumn MappingName="RegDate" HeaderText="Registration Date" MinimumWidth="130"/>
                            <syncfusion:GridCurrencyColumn MappingName="Amount" HeaderText="Insured Valuation" MinimumWidth="130"/>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <hc:Empty Description="No vehicle insurance policies registered."
                              Visibility="{Binding Insurances, Converter={StaticResource CollectionEmptyVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
