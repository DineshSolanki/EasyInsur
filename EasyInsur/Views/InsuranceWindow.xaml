<UserControl x:Class="EasyInsur.Views.InsuranceWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"   
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:modules="clr-namespace:EasyInsur.Modules"
             syncfusionskin:SfSkinManager.VisualStyle="FluentLight"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Card: Header & Vehicle Registration Form -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource RegionBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Vertical">
                <!-- Header Banner -->
                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="Vehicles &amp; Policies" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Background="#E3F2FD" CornerRadius="12" Padding="8,2">
                            <TextBlock Text="{Binding TotalInsurancesCount, StringFormat='{}{0} Registered Vehicles'}" 
                                       FontSize="11" FontWeight="Medium" Foreground="#1565C0"/>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Command="{Binding ReloadCommand}"
                            Style="{DynamicResource ButtonDefault}" Padding="10,4" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{DynamicResource PrimaryTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Input Fields Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Vehicle Number *" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <hc:TextBox Text="{Binding VehicleNo, UpdateSourceTrigger=PropertyChanged}" 
                                    hc:InfoElement.Placeholder="e.g. MH02AB1234" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Registration Date" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <DatePicker SelectedDate="{Binding RegDate, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Policy Amount (₹)" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <syncfusion:DoubleTextBox Value="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" 
                                                  Height="32" NumberDecimalDigits="2" MinValue="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Button Style="{DynamicResource ButtonPrimary}" Command="{Binding SaveCommand}" 
                                Content="Add Vehicle" Margin="0,0,6,0" Height="32" Padding="14,0"/>
                        <Button Style="{DynamicResource ButtonDefault}" Command="{Binding ResetCommand}" 
                                Content="Reset" Height="32" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Card: SfDataGrid & Pager -->
        <Border Grid.Row="1" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="8">
            <DockPanel LastChildFill="True">
                <!-- Pagination Footer -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,4" 
                        Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="PageSizeCombo" SelectedIndex="1" Width="70" Height="26" VerticalAlignment="Center">
                                <ComboBoxItem Content="15" Tag="15"/>
                                <ComboBoxItem Content="25" Tag="25"/>
                                <ComboBoxItem Content="50" Tag="50"/>
                                <ComboBoxItem Content="100" Tag="100"/>
                            </ComboBox>
                        </StackPanel>
                        <syncfusion:SfDataPager x:Name="DataPager" DockPanel.Dock="Right"
                                                PageSize="{Binding SelectedItem.Tag, ElementName=PageSizeCombo, FallbackValue=25}"
                                                Source="{Binding Insurances}"
                                                NumericButtonCount="5"
                                                Height="32"/>
                    </DockPanel>
                </Border>

                <!-- DataGrid & Empty State -->
                <Grid>
                    <syncfusion:SfDataGrid x:Name="DataGrid"
                                           ItemsSource="{Binding ElementName=DataPager, Path=PagedSource}"
                                           SelectedItem="{Binding SelectedInsurance, Mode=TwoWay}"
                                           AutoGenerateColumns="False"
                                           AllowFiltering="True"
                                           AllowSorting="True"
                                           AllowResizingColumns="True"
                                           ColumnSizer="Star"
                                           SelectionMode="Single"
                                           SelectionUnit="Row"
                                           ShowRowHeader="True"
                                           ScrollMode="Async">
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=modules:ContextMenuCommands.Copy}}"
                                          CommandParameter="{Binding}"
                                          Header="Copy">
                                <MenuItem.Icon>
                                    <Grid Height="16" Width="16">
                                        <Path Data="M5.5000009,2.500005 L10.500001,2.500005 14.500001,6.500005 14.500001,14.500005 5.5000009,14.500005 z M0,0 L4.0000037,0 4.0000037,12 0,12 z" 
                                              Fill="#FF3A3939" Stretch="Fill"/>
                                    </Grid>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding DataGrid.DataContext.DeleteInsuranceCommand}"
                                      CommandParameter="{Binding}"
                                      Header="Delete Record">
                                <MenuItem.Icon>
                                    <Grid Height="16" Width="16">
                                        <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z"
                                              Fill="#D32F2F" Stretch="Uniform"/>
                                    </Grid>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </syncfusion:SfDataGrid.RecordContextMenu>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Id" HeaderText="Policy ID" Width="90"/>
                        <syncfusion:GridTextColumn MappingName="VehicleNo" HeaderText="Vehicle Number" MinimumWidth="150"/>
                        <syncfusion:GridDateTimeColumn MappingName="RegDate" HeaderText="Registration Date" MinimumWidth="130"/>
                        <syncfusion:GridCurrencyColumn MappingName="Amount" HeaderText="Insured Valuation" MinimumWidth="130"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <hc:Empty Description="No vehicle insurance policies registered."
                          Visibility="{Binding Insurances, Converter={StaticResource CollectionEmptyVisibilityConverter}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
