<Window x:Class="EasyInsur.Views.ImageEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imageeditor="clr-namespace:Syncfusion.UI.Xaml.ImageEditor;assembly=Syncfusion.SfImageEditor.WPF"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        Title="Edit &amp; Crop Profile Photo" 
        Icon="../Resources/EasyInsur Logo.png"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        syncfusionskin:SfSkinManager.VisualStyle="FluentLight"
        Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                    <Path Data="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                          Stroke="#2563EB" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Syncfusion Image Editor" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Crop, rotate, enhance, or annotate profile photo before saving" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SfImageEditor Control -->
        <Border Grid.Row="1" Margin="10" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <imageeditor:SfImageEditor x:Name="Editor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Width="90" Height="34"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#475569" FontWeight="SemiBold"/>
                <Button Content="Apply &amp; Save" Click="Save_Click" Width="120" Height="34"
                        Background="#2563EB" BorderBrush="#1D4ED8" Foreground="#FFFFFF" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
