<UserControl x:Class="EasyInsur.Views.PersonDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"    
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewmodels:PersonDetailsViewModel}"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:local="clr-namespace:EasyInsur.Modules"
             xmlns:viewmodels="clr-namespace:EasyInsur.ViewModels"
             syncfusionskin:SfSkinManager.VisualStyle="FluentLight"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="1" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Profile Registration Form Card -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: People Directory Grid Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                          Stroke="#2563EB" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Client &amp; Agent Registration" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource SectionBadgeStyle}" Margin="10,0,0,0">
                            <TextBlock Text="Directory Profile" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Register customers and agents, configure contact details, and establish initial ledger balances."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDefault}" Command="{Binding ResetCommand}" Height="34" Margin="0,0,8,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ReloadGeometry}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset Form" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SaveGeometry}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Save Person" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: REGISTRATION FORM CARD -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Form Fields (2 Rows) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Basic Identity Details -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                            </Border>
                            <TextBlock Text="Identity &amp; Profile Information" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Person Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <hc:ComboBox SelectedIndex="0" AutoComplete="True" Text="{Binding PersonType}" Height="34">
                                    <ComboBoxItem Content="Customer"/>
                                    <ComboBoxItem Content="Agent"/>
                                </hc:ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Person ID" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                </TextBlock>
                                <hc:TextBox Text="{Binding PersonId, Mode=TwoWay}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="First Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                </TextBlock>
                                <hc:TextBox Text="{Binding FirstName}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Last Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                </TextBlock>
                                <hc:TextBox Text="{Binding LastName}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Registration Date" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                </TextBlock>
                                <hc:DatePicker SelectedDateFormat="Short" SelectedDate="{Binding RegistrationDate}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="0,0,4,0">
                                <TextBlock Text="Opening Balance (₹)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <syncfusion:CurrencyTextBox Style="{StaticResource TextBoxExtend}" Value="{Binding Balance}" Height="34" CurrencyDecimalDigits="2"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Row 1: Contact Details -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Contact &amp; Communication Channels" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Country Code" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:ComboBox x:Name="CountryBox" Grid.Column="0" DisplayMemberPath="name" hc:DropDownElement.AutoWidth="True" AutoComplete="True" SelectedValue="{Binding SelectedCountry,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ItemsSource="{Binding CountryDetails}" Height="34" Margin="0,0,4,0"/>
                                    <hc:TextBox Grid.Column="1" IsTabStop="False" Text="{Binding ElementName=CountryBox, Path=SelectedValue.dial_code}" IsReadOnly="True" Height="34"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Mobile Number" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                </TextBlock>
                                <hc:MaskedTextBox hc:InfoElement.Placeholder="{Binding ElementName=CountryBox, Path=SelectedValue.ExampleNumber}" Mask="{Binding ElementName=CountryBox, Path=SelectedValue.MobileMask}" AutoMoveFocus="True" Text="{Binding Mobile,Mode=TwoWay}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Email Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <hc:TextBox hc:InfoElement.Placeholder="Enter email address" Text="{Binding Email,Mode=TwoWay}" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Right: Photo Selector Card -->
                <Border Grid.Column="1" Margin="14,0,0,0" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <hc:ImageSelector Height="110" Width="110" Stretch="UniformToFill" ToolTip="{Binding ImagePathTag, Mode=TwoWay}"/>
                        <TextBlock Text="Profile Photo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 2: PEOPLE DIRECTORY DATAGRID CARD -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="10">
            <DockPanel LastChildFill="True">
                <!-- DataGrid Header -->
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Registered Clients &amp; Agents Directory" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="Records List" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Footer: Rows per page selector & DataPager -->
                <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <hc:ComboBox x:Name="PageSizeCombo" SelectedIndex="1" Width="95" Height="26">
                                <ComboBoxItem Content="15 rows" Tag="15"/>
                                <ComboBoxItem Content="25 rows" Tag="25"/>
                                <ComboBoxItem Content="50 rows" Tag="50"/>
                                <ComboBoxItem Content="100 rows" Tag="100"/>
                            </hc:ComboBox>
                        </StackPanel>
                        <syncfusion:SfDataPager x:Name="SfDataPager" 
                                                DockPanel.Dock="Right"
                                                NumericButtonCount="7"
                                                Height="30"
                                                PageSize="{Binding ElementName=PageSizeCombo, Path=SelectedValue.Tag, FallbackValue=25, TargetNullValue=25}" 
                                                HorizontalAlignment="Right"
                                                Source="{Binding PersonData}" />
                    </DockPanel>
                </Border>

                <!-- DataGrid & Empty State Overlay -->
                <Grid>
                    <syncfusion:SfDataGrid x:Name="DataGrid" BorderThickness="1" BorderBrush="#E2E8F0" AutoGenerateColumns="False"
                                           ItemsSource="{Binding ElementName=SfDataPager,Path=PagedSource}" AllowDraggingColumns="True"
                                           AllowFiltering="True" AllowSorting="True" ColumnSizer="Star" AllowResizingColumns="True"
                                           ShowRowHeader="True" GridLinesVisibility="Horizontal" GridCopyOption="CopyData" SelectionUnit="Any"
                                           HeaderLinesVisibility="Both" ScrollMode="Async" ShowGroupDropArea="True"
                                           EnableDataVirtualization="True">
                        <syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ExpandAll" Header="Expand All" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ExpandAll}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M65.8418,72.2030999999999L63.4438,69.8030999999999L59.2608,73.9850999999999L57.2318,71.9561L61.4128,67.7761L59.0138,65.3750999999999L65.8418,65.3750999999999z M55.8888,82.2811L49.0608,82.2811L49.0608,75.4541L51.4588,77.8531L55.6428,73.6700999999999L57.6708,75.7000999999999L53.4888,79.8821z M45.4508,85.8280999999999L69.4508,85.8280999999999L69.4508,61.8280999999999L45.4508,61.8280999999999z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CollapseAll" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.CollapseAll}}"
                                          CommandParameter="{Binding}" Header="Collapse All">
                                    <MenuItem.Icon>
                                        <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="F1M62.4873,119.8345L55.6593,119.8345L55.6593,113.0065L58.0573,115.4065L62.2403,111.2245L64.2693,113.2535L60.0883,117.4335z M54.2233,128.0975L51.8253,125.6985L47.6413,129.8805L45.6123,127.8515L49.7943,123.6695L47.3953,121.2705L54.2233,121.2705z M42.9413,132.5525L66.9413,132.5525L66.9413,108.5525L42.9413,108.5525z"
                                              Fill="#FF5A5A5B" Stretch="Fill" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="ClearGroups" Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearGroups}}"
                                          CommandParameter="{Binding}" Header="Clear Groups" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupDropAreaContextMenu>
                        <syncfusion:SfDataGrid.HeaderContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.SortAscending}}" CommandParameter="{Binding}" Header="Sort Ascending" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.SortDescending}}" CommandParameter="{Binding}" Header="Sort Descending" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearSorting}}" CommandParameter="{Binding}" Header="Clear Sorting" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ClearFiltering}}" CommandParameter="{Binding}" Header="Clear Filtering" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.GroupThisColumn}}" CommandParameter="{Binding}" Header="Group by this Column" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.ShowHideGroupArea}}" CommandParameter="{Binding}" Header="Expand/Collapse Group Drop Area" />
                                <Separator />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.BestFit}}" CommandParameter="{Binding}" Header="Best Fit" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.HeaderContextMenu>
                        <syncfusion:SfDataGrid.GroupCaptionContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Expand}}" CommandParameter="{Binding}" Header="Expand" />
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Collapse}}" CommandParameter="{Binding}" Header="Collapse" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.GroupCaptionContextMenu>
                        <syncfusion:SfDataGrid.RecordContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Copy}}" CommandParameter="{Binding}" Header="Copy" />
                                <MenuItem Command="{Binding DataGrid.DataContext.AddPayment}" CommandParameter="{Binding}" Header="Add Payment" />
                            </ContextMenu>
                        </syncfusion:SfDataGrid.RecordContextMenu>
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Id" HeaderText="ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="PersonID" HeaderText="PID" MinimumWidth="75"/>
                            <syncfusion:GridTextColumn MappingName="FirstName" HeaderText="First Name" MinimumWidth="100"/>
                            <syncfusion:GridTextColumn MappingName="LastName" HeaderText="Last Name" MinimumWidth="100"/>
                            <syncfusion:GridCurrencyColumn MappingName="Balance" HeaderText="Balance" MinimumWidth="90"/>
                            <syncfusion:GridDateTimeColumn MappingName="RegDate" HeaderText="Registration Date" TextAlignment="Center" MinimumWidth="110"/>
                            <syncfusion:GridTextColumn MappingName="Mobile" HeaderText="Mobile No." MinimumWidth="100"/>
                            <syncfusion:GridTextColumn MappingName="Email" HeaderText="Email" MinimumWidth="130"/>
                            <syncfusion:GridImageColumn MappingName="ImagePath" AllowEditing="False" AllowGrouping="False" HeaderText=""
                                                        AllowFocus="False" AllowFiltering="False" Stretch="Fill"
                                                        StretchDirection="Both" ImageWidth="32" TextAlignment="Center"
                                                        ImageHeight="32" VerticalAlignment="Center" UseBindingValue="True"
                                                        MinimumWidth="48" MaximumWidth="48" Width="48"
                                                        ValueBinding="{Binding Path=ImagePath, Converter={StaticResource StringToImageConverter}}"/>
                        </syncfusion:SfDataGrid.Columns>
                        <syncfusion:SfDataGrid.DetailsViewDefinition>
                            <syncfusion:TemplateViewDefinition RowTemplate="{StaticResource DetailsViewTemplate}"/>
                        </syncfusion:SfDataGrid.DetailsViewDefinition>
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" Position="Bottom">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="PeopleCount" Format="'Total People: {Count:d}'" MappingName="Mobile" SummaryType="CountAggregate" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                    </syncfusion:SfDataGrid>

                    <hc:Empty Description="No clients or agents found in directory."
                              Visibility="{Binding PersonData, Converter={StaticResource CollectionEmptyVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
