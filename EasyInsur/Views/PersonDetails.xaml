<UserControl x:Class="HandyControlWpfCoreApp1.Views.PersonDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"    
             xmlns:hc ="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:HandyControlWpfCoreApp1.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PersonDetailsViewModel}"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:local="clr-namespace:HandyControlWpfCoreApp1.Modules"
             syncfusionskin:SfSkinManager.VisualStyle="Metro"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailsViewTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="125"/>
			</Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="5" Height="150" HorizontalAlignment="Left" 
                   Source="{Binding Path=Data.ImagePath}" />
            <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"
                   Margin="25,0,0,0" Content="Personal Details" FontWeight="Bold" />
            <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="1" 
						HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="Name :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Data.FirstName" />
                                <Binding Path="Data.LastName" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontWeight="SemiBold" Content="Mobile No :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Data.Mobile}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontWeight="SemiBold" Content="Email :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Data.Email}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontWeight="SemiBold" Content="Registration Date :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Data.RegDate}"/>
                </StackPanel>
            </StackPanel>
            <Label Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" Margin="25,0,0,0"
                   Content="Transactions Details" FontWeight="Bold" />
            <StackPanel Orientation="Vertical" Grid.Column="2" Grid.Row="1" 
						HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" Content="initial Balance :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Data.Balance, StringFormat='{}{0:C}'}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" Content="Balance :"/>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Data.Balance, StringFormat='{}{0:C}'}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <hc:ComboBox SelectedIndex="0" Grid.Row="0" Grid.Column="0" AutoComplete="True" Text="{Binding PersonType}" hc:TitleElement.Title="Person type" hc:TitleElement.TitlePlacement="Top" Margin="5">
            <ComboBoxItem Content="Customer"/>
            <ComboBoxItem Content="Agent"/>
        </hc:ComboBox>
        <hc:TextBox Grid.Row="0" Grid.Column="1" hc:TitleElement.Title="Person ID" hc:InfoElement.Necessary="True" Text="{Binding PersonID}" hc:TitleElement.TitlePlacement="Top" Margin="5"/>
        <hc:TextBox Grid.Row="0" Grid.Column="2" hc:TitleElement.Title="First Name" hc:InfoElement.Necessary="True" Text="{Binding FirstName}" hc:TitleElement.TitlePlacement="Top" Margin="5"/>
        <hc:TextBox Grid.Row="0" Grid.Column="3" hc:TitleElement.Title="Last Name" hc:InfoElement.Necessary="True" Text="{Binding LastName}"  hc:TitleElement.TitlePlacement="Top" Margin="5"/>
        <hc:DatePicker SelectedDateFormat="Short" hc:InfoElement.Necessary="True" Grid.Row="0" Grid.Column="4" hc:TitleElement.Title="Registration Date" hc:TitleElement.TitlePlacement="Top" Margin="5" Text="{Binding RegistrationDate}"/>
        <syncfusion:CurrencyTextBox Grid.Row="0" Grid.Column="5" hc:InfoElement.Necessary="True" Style="{StaticResource TextBoxExtend}"  hc:TitleElement.Title="Balance" Value="{Binding Balance}"  hc:TitleElement.TitlePlacement="Top" Margin="5"/>
        <hc:ImageSelector Grid.Row="0" Grid.RowSpan="2" Grid.Column="6" Height="150" Width="150" Margin="10" Stretch="Fill" ToolTip="{Binding ImagePath, Mode=TwoWay}"/>
            <hc:SimpleStackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <hc:ComboBox x:Name="CountryBox" DisplayMemberPath="name" hc:DropDownElement.AutoWidth="True"  MinWidth="120" MaxWidth="120"  AutoComplete="True" SelectedValue="{Binding SelectedCountry,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ItemsSource="{Binding CountryDetails}"   hc:TitleElement.Title="Country Code" hc:TitleElement.TitlePlacement="Top" Margin="5,0,0,0"/>
            <hc:TextBox IsTabStop="False" hc:TitleElement.Title="Code" Text="{Binding ElementName=CountryBox, Path=SelectedValue.dial_code}" hc:TitleElement.TitlePlacement="Top" Margin="5,0,0,0" VerticalAlignment="Top" IsReadOnly="True" MaxWidth="60"/>
        </hc:SimpleStackPanel>
        <hc:MaskedTextBox hc:InfoElement.Placeholder="{Binding ElementName=CountryBox, Path=SelectedValue.ExampleNumber}" Mask="{Binding ElementName=CountryBox, Path=SelectedValue.MobileMask}" AutoMoveFocus="True"  Grid.Row="1" Grid.Column="1" hc:TitleElement.Title="Mobile No." hc:InfoElement.Necessary="True" Text="{Binding Mobile,Mode=TwoWay}" hc:TitleElement.TitlePlacement="Top" Margin="5,0,0,0" VerticalAlignment="Top"/>
        <hc:SplitButton Grid.Row="1" Grid.Column="2" Style="{StaticResource SplitButtonPrimary}" Content="Save person" Command="{Binding SaveCommand}" Margin="10,26,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <hc:SplitButton.DropDownContent>
                <StackPanel>
                    <MenuItem Header="Reset form" Command="{Binding ResetCommand}" />
                </StackPanel>
            </hc:SplitButton.DropDownContent>
        </hc:SplitButton>
        <syncfusion:SfDataGrid x:Name="DataGrid" BorderThickness="1,1,1,1"  Grid.Row="2" Grid.Column="0" Margin="10" Grid.ColumnSpan="7" AutoGenerateColumns="False"
